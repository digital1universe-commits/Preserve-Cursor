{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["src/engine/*"]
    }
  },
  "include": ["next-env.d.ts", "app", "src", "vite.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
